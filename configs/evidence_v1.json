      "damping_nm_s_per_rad": 0.4,
      "delay_s": 0.01
    }
  },
  "optimizer": {
    "backend": "scipy_parallel_fd",
    "method": "trf",
    "loss": "linear",
    "max_iters": 200,
    "budget_meaning": "scipy_max_nfev",
    "ftol": 1e-08,
    "xtol": 1e-08,
    "gtol": 1e-08,
    "x_scale": "free_parameter_bound_widths",
    "diff_step": 1e-05,
    "finite_difference_semantics": "eps*max(1,abs(x)); sign toward bounds midpoint; clipped candidate",
    "rollout_workers": 1,
    "numerical_library_threads": 1,
    "delay_only_start_s": 0.002,
    "selection": "lowest_finite_training_objective_including_nonconverged",
    "objective": "0.5*sum(noise_normalized_residual**2)",
    "residual_sign": "measured_minus_prediction",
    "amplitude_normalization": false
  },
  "phase_lag": {
    "window_margin_s": 0.12,
    "lag_min_s": -0.06,
    "lag_max_s": 0.06,
    "lag_step_s": 0.002,
    "tie_tolerance": 1e-12,
    "tie_rule": "smallest_absolute_lag_then_negative",
    "minimum_peak_correlation": 0.2,
    "minimum_signal_std": "sensor_noise_sigma",
    "positive_sign": "measurements_lag_candidate_prediction"
  },
  "metrics": {
    "primary": "heldout_trajectory_prediction",
    "per_trajectory": [
      "qpos_rmse",
      "qvel_rmse",
      "qpos_p95_absolute_error",
      "qvel_p95_absolute_error",
      "noise_normalized_rmse"
    ],
    "normalized_rmse": "sqrt(mean((qpos_error/sigma_qpos)**2+(qvel_error/sigma_qvel)**2)/2)",
    "split_aggregation": "sqrt(mean(per_trajectory_rmse**2)); equal_trajectory_weight",
    "relative_improvement": "1-identified_rmse/nominal_rmse; null_reason_if_zero_denominator",
    "bound_hit_fraction": 0.001,
    "consistent_bound_hit_seed_count": 3,
    "latent_clean": "secondary_diagnostic_only",
    "seed_aggregation": [
      "median",
      "minimum",
      "maximum",
      "finite_count",
      "failures",
      "nonconvergence"
    ],
    "missing_diagnostics": "null_with_reason"
  },
  "criteria": {
    "physical_relative_error_max": 0.1,
    "minimum_recovery_seed_count": 4,
    "fixed_seed_denominator": 5,
    "heldout_median_improvement_min": 0.2,
    "require_nonnegative_each_heldout_median": true,
    "delay_absolute_error_max_s": 0.002,
    "smoke_runtime_target_s": 60.0,
