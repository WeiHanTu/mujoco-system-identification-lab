root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.csv]
end_of_line = crlf

[docs/report.html]
# Preserve upstream-generated evidence bytes.
insert_final_newline = unset

[docs/reports/**]
insert_final_newline = unset
